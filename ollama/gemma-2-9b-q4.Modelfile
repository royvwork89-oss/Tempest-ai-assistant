FROM ../models-localai/gemma-2-9b-it-Q4_K_M.gguf

PARAMETER temperature 0.35
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.18
PARAMETER mirostat 2
PARAMETER mirostat_tau 4.5
PARAMETER mirostat_eta 0.1
PARAMETER num_ctx 4096
PARAMETER num_gpu 99
PARAMETER stop "<end_of_turn>"
PARAMETER stop "<eos>"
PARAMETER stop "¿Hay algo más"
PARAMETER stop "¿Hay algún"

TEMPLATE """{{- if .System }}<start_of_turn>user
{{ .System }}<end_of_turn>
{{ end }}{{- range .Messages }}<start_of_turn>{{ .Role }}
{{ .Content }}<end_of_turn>
{{ end }}<start_of_turn>model
"""